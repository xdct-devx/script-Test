local MapModeBox = Tabs.Main:AddRightGroupbox('Auto Map & Mode')

local StoryMapName = 'Story'
local MapNames = { 'Classy', 'Sand', 'Story', 'bp', 'defauly', 'fa', 'glass' }
local ModeList = {
    { 'Siege Mode', 'truestart' },
    { 'Hard Mode', 'what' },
    { 'Endless Mode', 'start' },
    { 'Endless: Hardmode', 'deadly' },
    { 'Nightmare Mode', 'nightmare' },
    { 'Death Mode', 'wh' },
    { 'Astra Mode', 'astra' },
}
local ModePartByLabel, ModeLabels = {}, {}
for _, m in ipairs(ModeList) do
    ModePartByLabel[m[1]] = m[2]
    table.insert(ModeLabels, m[1])
end

local AutoMapEnabled, AutoModeEnabled = false, false
local SelectedMap, SelectedMode = MapNames[1], ModeLabels[1]
local ModeDelay = 2.5
local MM = { phase = 'map', goneSince = nil, lastMapFire = -100, lastModeFire = -100 }
local MMRunning = false

local function GetLobby() return workspace:FindFirstChild('lobby') end
local function GetMapBtns()
    local lobby = GetLobby()
    return lobby and lobby:FindFirstChild('btns') or nil
end
local function MapBtnsPresent()
    local b = GetMapBtns()
    return b ~= nil and #b:GetChildren() > 0
end

local ModeCache, ModeSearchAt = {}, {}
local function SearchModeInstance(name)
    local lobby = GetLobby()
    if lobby then
        local direct = lobby:FindFirstChild(name)
        if direct and PromptOf(direct) then return direct end
        local deep = lobby:FindFirstChild(name, true)
        if deep and PromptOf(deep) then return deep end
        for _, d in ipairs(lobby:GetDescendants()) do
            if d.Name == name and PromptOf(d) then return d end
        end
    end
    local top = workspace:FindFirstChild(name)
    if top and PromptOf(top) then return top end
    return nil
end

local function FindModeInstance(name)
    local cached = ModeCache[name]
    if cached and cached:IsDescendantOf(workspace) then return cached end
    ModeCache[name] = nil
    local now = os.clock()
    if now - (ModeSearchAt[name] or -100) < 0.5 then return nil end
    ModeSearchAt[name] = now
    local found = SearchModeInstance(name)
    ModeCache[name] = found
    return found
end

local function MapModeStep()
    local now = os.clock()
    local modeName = ModePartByLabel[SelectedMode]

    if MM.phase == 'wait_return' then
        if modeName and FindModeInstance(modeName) then
            MM.phase = 'map'
            MM.goneSince = nil
        end
        return
    end

    local btnsNow = MapBtnsPresent()

    if MM.phase == 'map' then
        if btnsNow then
            MM.goneSince = nil
            if AutoMapEnabled and now - MM.lastMapFire >= 2 then
                local folder = GetMapBtns()
                local inst = folder and SelectedMap and folder:FindFirstChild(SelectedMap)
                if inst then
                    MM.lastMapFire = now
                    TeleportAndPress(inst)
                end
            end
        elseif AutoModeEnabled and not (SelectedMap == StoryMapName and AutoMapEnabled) then
            MM.goneSince = MM.goneSince or now
            if now - MM.goneSince >= ModeDelay then
                MM.phase = 'mode'
            end
        end
        return
    end

    if MM.phase == 'mode' then
        if btnsNow then
            MM.phase = 'map'
            MM.goneSince = nil
            return
        end
        local inst = modeName and FindModeInstance(modeName)
        if not inst then
            MM.phase = 'wait_return'
            return
        end
        if now - MM.lastModeFire >= 1.5 then
            MM.lastModeFire = now
            TeleportAndPress(inst)
        end
    end
end

