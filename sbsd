local TransparencyKeys = {
    ElementBackgroundTransparency = 0.93,
    PanelBackgroundTransparency = 0.95,
    SectionBoxTransparency = 0.95,
    SectionBoxBackgroundTransparency = 0.97,
    LabelBackgroundTransparency = 0.95,
    TabBackgroundHoverTransparency = 0.97,
    TabBackgroundActiveTransparency = 0.93,
}
local CustomThemeName = 'NotNoxiaCustom'

ApplyThemeLook = function()
    pcall(function()
        local base = WindUI:GetThemes()[BaseThemeName]
        if not base then return end
        local p = (Options.BGWindowTransparency and Options.BGWindowTransparency.Value or 0) / 100
        if p <= 0 then
            WindUI:SetTheme(BaseThemeName)
            return
        end
        local derived = {}
        for k, v in pairs(base) do derived[k] = v end
        derived.Name = CustomThemeName
        for key, default in pairs(TransparencyKeys) do
            local orig = type(base[key]) == "number" and base[key] or default
            derived[key] = orig + (1 - orig) * p
        end
        WindUI:AddTheme(derived)
        WindUI:SetTheme(CustomThemeName)
    end)
end

