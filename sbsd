    end)
end

local function ApplyBackground(showNotify)
    if not WindowObj then return end
    local image = NormalizeAssetId(Options.BGAssetId and Options.BGAssetId.Value or "")
    if image == nil then
        if showNotify then Library:Notify('Invalid Asset ID', 3) end
        SetBgStatus('invalid ID')
        ApplyBackgroundLook()
        return false
    end

    if image == "" then
        BgRequest = BgRequest + 1
        LastBgImage = ""
        pcall(function() WindowObj:SetBackgroundImage("") end)
        ApplyBackgroundLook()
        SetBgStatus('none')
        if showNotify then Library:Notify('Background removed', 2) end
        return true
    end

    local digits = image:match("(%d+)$")
    BgRequest = BgRequest + 1
    local myRequest = BgRequest
    SetBgStatus('loading...')

    task.spawn(function()
        local resolved, kind = ResolveBackground(digits)
        if myRequest ~= BgRequest or Unloaded then return end
        LastBgImage = resolved
