function Groupbox:AddDropdown(id, info)
    info = info or {}
    local values = info.Values or {}
    local multi = info.Multi and true or false
    local function toMap(list)
        local m = {}
        if type(list) == "table" then
            for k, v in pairs(list) do
                if type(k) == "number" then m[tostring(v)] = true
                elseif v then m[k] = true end
            end
        end
        return m
    end
    local function toList(map)
        local l = {}
        for _, v in ipairs(values) do if map[v] then table.insert(l, v) end end
        return l
    end

    local initList, initSingle = {}, nil
    local d = info.Default
    if multi then
        if type(d) == "number" and values[d] then initList = { values[d] }
        elseif type(d) == "string" then initList = { d }
        elseif type(d) == "table" then initList = toList(toMap(d)) end
    else
        if type(d) == "number" then initSingle = values[d]
        elseif type(d) == "string" then initSingle = d end
    end

    local opt = MakeOption(id, "Dropdown", {
        Values = values, Multi = multi,
        Value = multi and toMap(initList) or initSingle,
    })
    local el
    local ok, err = pcall(function()
        el = self.Container:Dropdown({
            Title = CleanText(info.Text or id),
            Desc = SHOW_DESC and info.Tooltip and CleanText(info.Tooltip) or nil,
            Values = values,
            Value = multi and initList or initSingle,
            Multi = multi,
            AllowNone = multi and true or nil,
            Callback = function(v)
                if opt._setting then return end
                local out
                if multi then out = toMap(v) else out = (type(v) == "table") and v[1] or v end
                opt.Value = out
                if not UIReady then return end
                SafeCall(info.Callback, out)
                opt:_fire(out)
            end,
        })
    end)
    if not ok then warn("[NotNoxia] Dropdown '" .. id .. "': " .. tostring(err)) end
    function opt:SetValue(v)
        local out
        if multi then out = toMap(v) else out = (type(v) == "table") and v[1] or v end
        opt.Value = out
        opt._setting = true
        pcall(function()
            if el and el.Select then
                if multi then el:Select(toList(out)) else el:Select(out) end
            end
        end)
        opt._setting = false
        SafeCall(info.Callback, out)
        opt:_fire(out)
    end
    function opt:SetValues(list)
        values = list or {}
        opt.Values = values
        pcall(function() if el and el.Refresh then el:Refresh(values) end end)
    end
    opt.Element = el
    return opt
end

