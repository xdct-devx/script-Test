local function PromptOf(inst)
    if not inst then return nil end
    if inst:IsA("ProximityPrompt") then return inst end
    return inst:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function PromptPosition(prompt)
    local p = prompt.Parent
    if not p then return nil end
    local pos
    pcall(function()
        if p:IsA("BasePart") then pos = p.Position
        elseif p:IsA("Attachment") then pos = p.WorldPosition
        else pos = p:GetPivot().Position end
    end)
    return pos
end

local function TeleportAndPress(inst)
    local prompt = PromptOf(inst)
    if not prompt then return false end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local pos = PromptPosition(prompt)
    if pos then
        pcall(function() hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) end)
    end
    pcall(function() prompt.HoldDuration = 0 end)
    pcall(function() prompt.RequiresLineOfSight = false end)
    task.wait(0.15)
    if fireproximityprompt then
        pcall(fireproximityprompt, prompt, 1, true)
    else
        pcall(function() prompt:InputHoldBegin(); task.wait(0.05); prompt:InputHoldEnd() end)
    end
    return true
end

local function ListChildNames(inst)
    local names = {}
    if inst then
        for _, c in ipairs(inst:GetChildren()) do table.insert(names, c.Name) end
    end
    table.sort(names)
