local function NormalizeAssetId(text)
    local s = tostring(text or ""):gsub("%s+", "")
    if s == "" then return "" end
    local digits = s:match("^(%d+)$")
        or s:match("^rbxassetid://(%d+)")
        or s:match("[?&]id=(%d+)")
        or s:match("/library/(%d+)")
        or s:match("/catalog/(%d+)")
        or s:match("/asset/(%d+)")
    if digits then return "rbxassetid://" .. digits end
    return nil
end

local function DecalToImageId(digits)
    local okObjs, objs = pcall(function() return game:GetObjects("rbxassetid://" .. digits) end)
    if not okObjs or type(objs) ~= "table" then return nil end

    local function textureOf(o)
        local ok, v = pcall(function()
            if o:IsA("Decal") or o:IsA("Texture") then return o.Texture end
            if o:IsA("ImageLabel") or o:IsA("ImageButton") then return o.Image end
            return nil
        end)
        if ok and type(v) == "string" and v ~= "" then
            return v:match("[?&]id=(%d+)") or v:match("rbxassetid://(%d+)")
        end
        return nil
    end

    for _, o in ipairs(objs) do
        local id = textureOf(o)
        if id then return id end
        local okD, descs = pcall(function() return o:GetDescendants() end)
        if okD and type(descs) == "table" then
            for _, d in ipairs(descs) do
                local id2 = textureOf(d)
                if id2 then return id2 end
            end
        end
    end
    return nil
end

local function CanLoadImage(url)
    local ok, loaded = pcall(function()
        local lbl = Instance.new("ImageLabel")
        local done = false
        task.spawn(function()
            pcall(function() game:GetService("ContentProvider"):PreloadAsync({ lbl }) end)
            done = true
        end)
        local waited = 0
        while not done and waited < 5 do task.wait(0.1); waited = waited + 0.1 end
        lbl.Image = url
        local result = lbl.IsLoaded
        pcall(function() lbl:Destroy() end)
        return result
    end)
    if not ok then return true end
    return loaded and true or false
end

local function ResolveBackground(digits)
    local direct = "rbxassetid://" .. digits
    local imageId = DecalToImageId(digits)
    if imageId then return "rbxassetid://" .. imageId, "decal" end
    if CanLoadImage(direct) then return direct, "image" end
    return "rbxthumb://type=Asset&id=" .. digits .. "&w=420&h=420", "thumbnail"
end

