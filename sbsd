local function OSHook(id)
    if OS.hooked[id] or not Toggles[id] then return end
    OS.hooked[id] = true
    Toggles[id]:OnChanged(function(v)
        for _, e in ipairs(OS.hot) do
            if e.id == id then OSPaint(e.btn, v) end
        end
    end)
end

local function OSRebuildHotkeyButtons()
    OSDisconnect(OS.hotConns)
    for _, e in ipairs(OS.hot) do pcall(function() e.btn:Destroy() end) end
    OS.hot = {}
    if not (Toggles.OSHotkeyButtons and Toggles.OSHotkeyButtons.Value) then return end

    local chosen = Options.OSButtonList and Options.OSButtonList.Value or {}
    local vx, vy = OSViewport()
    local size = OSSize()
    local rows = math.max(1, math.floor((vy - 140) / (size + 8)))
    local index = 0
    for _, f in ipairs(OSFeatures) do
        if type(chosen) == "table" and chosen[f[1]] and (f[3] or (f[2] and Toggles[f[2]])) then
            local col, row = math.floor(index / rows), index % rows
            local pos = UDim2.fromOffset(vx - (size + 12) * (col + 1) - (size + 12), 70 + row * (size + 8))
            local id, fn = f[2], f[3]
            local btn = OSMakeButton(f[1], size, pos, function()
                if fn then fn() return end
                local t = Toggles[id]
                if t then t:SetValue(not t.Value) end
            end, OS.hotConns)
            table.insert(OS.hot, { id = id, btn = btn })
            if id then OSHook(id); OSPaint(btn, Toggles[id].Value) else OSPaint(btn, false) end
            index = index + 1
        end
    end
end

