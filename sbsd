end

function Library:SetWatermark(_) end
function Library:OnUnload(fn) table.insert(UnloadCallbacks, fn) end
function Library:Unload()
    if Library.Unloaded then return end
    Library.Unloaded = true
    for _, fn in ipairs(UnloadCallbacks) do SafeCall(fn) end
    pcall(function() if WindowObj then WindowObj:Destroy() end end)
end

local function KeyName(v)
    if typeof(v) == "EnumItem" then return v.Name end
    return tostring(v)
end

local function MakeOption(id, kind, init)
    local o = init or {}
    o.Type = kind
    o.Changed = {}
    function o:OnChanged(fn) table.insert(self.Changed, fn) return self end
    function o:_fire(...)
        for _, fn in ipairs(self.Changed) do SafeCall(fn, ...) end
    end
    Options[id] = o
    return o
end

local Groupbox = {}
Groupbox.__index = Groupbox

local function AttachLabelAddons(label, sec)

    function label:AddColorPicker(id, info)
        info = info or {}
        return sec:_ColorPicker(id, info, label.Text)
    end
    function label:AddKeyPicker(id, info)
        info = info or {}
        return sec:_KeyPicker(id, info, label.Text, nil)
    end
    return label
end

function Groupbox:_ColorPicker(id, info, title)
    local default = info.Default or Color3.new(1, 1, 1)
    local opt = MakeOption(id, "ColorPicker", { Value = default, Transparency = info.Transparency or 0 })
    local el
    local ok, err = pcall(function()
        el = self.Container:Colorpicker({
            Title = CleanText(info.Title or title or id),
            Default = default,
            Transparency = info.Transparency,
            Callback = function(color, transparency)
                if opt._setting then return end
                opt.Value = color
                if transparency then opt.Transparency = transparency end
                if not UIReady then return end
                SafeCall(info.Callback, color)
                opt:_fire(color)
            end,
        })
    end)
    if not ok then warn("[NotNoxia] ColorPicker '" .. id .. "': " .. tostring(err)) end
    function opt:SetValue(c)
        if typeof(c) == "table" then c = c[1] end
        if typeof(c) ~= "Color3" then return end
        opt.Value = c
        opt._setting = true
        pcall(function() if el then el:Set(c, opt.Transparency) end end)
        opt._setting = false
        SafeCall(info.Callback, c)
        opt:_fire(c)
    end
    function opt:SetValueRGB(c) opt:SetValue(c) end
    opt.Element = el
    return opt
end

function Groupbox:_KeyPicker(id, info, title, syncToggle)
    local default = KeyName(info.Default or "None")
    local opt = MakeOption(id, "KeyPicker", { Value = default, Mode = info.Mode or "Toggle" })
    local el
    local function pressed(_)
        if Library.Unloaded or not UIReady then return end
        if syncToggle and Toggles[syncToggle] then
            Toggles[syncToggle]:SetValue(not Toggles[syncToggle].Value)
        end
        SafeCall(info.Callback, true)
        opt:_fire(true)
    end
    if not info.NoUI or id == "MenuKeybind" then
        pcall(function()
            el = self.Container:Keybind({
                Title = CleanText(info.Text or title or id),
                Value = default,
                Callback = function(k)
                    if id == "MenuKeybind" then return end
                    pressed(k)
                end,
            })
        end)
    end
    if el then
        task.spawn(function()
            local last = opt.Value
            while not Library.Unloaded do
                task.wait(0.4)
                local cur = el.Value
                if cur and cur ~= last then
                    last = cur
                    opt.Value = cur
                    if id == "MenuKeybind" and WindowObj then
