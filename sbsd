local function applyBulletTeleport(origin, targetPart)
    if not _G.BulletTP or not targetPart then
        return origin
    end
    return (targetPart.CFrame * CFrame.new(0, 0, 1)).p
end

local AimRemoteKeywords = { "fire", "hit", "attack", "damage", "shoot", "bullet", "projectile", "mouse" }

local function IsAimRemoteName(name)
    local lowered = string.lower(name)
    for _, kw in ipairs(AimRemoteKeywords) do
        if string.find(lowered, kw, 1, true) then return true end
    end
    return false
end

if not oldNamecall then
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if checkcaller() then return oldNamecall(self, ...) end

        local method = getnamecallmethod()

        if _G.AutoQTE and method == "FireServer" and (...) == "QTEResult" then
            local qteArgs = {...}
            qteArgs[2] = true
            return oldNamecall(self, unpack(qteArgs, 1, math.max(select("#", ...), 2)))
        end

        if not _G.SilentAim or not TargetPart or not CurrentTarget then return oldNamecall(self, ...) end

        local args = {...}
        local argc = select("#", ...)

        if (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance" then
            if IsAimRemoteName(self.Name) then
                if not ShouldHit() then return oldNamecall(self, ...) end

                local modified = false
                for i = 1, argc do
                    local arg = args[i]
                    if typeof(arg) == "Vector3" then
                        if _G.BulletTP then
                            args[i] = applyBulletTeleport(arg, TargetPart)
                        else
                            args[i] = TargetPart.Position
                        end
                        modified = true
                    elseif typeof(arg) == "CFrame" then
                        local origin = arg.Position
                        local targetPos = _G.BulletTP and applyBulletTeleport(origin, TargetPart) or TargetPart.Position
                        args[i] = CFrame.new(origin, targetPos)
                        modified = true
                    elseif typeof(arg) == "Ray" then
                        local origin = arg.Origin
                        local newOrigin = _G.BulletTP and applyBulletTeleport(origin, TargetPart) or origin
                        args[i] = Ray.new(newOrigin, (TargetPart.Position - newOrigin).Unit * arg.Direction.Magnitude)
                        modified = true
                    end
                end

                if modified then return oldNamecall(self, unpack(args, 1, argc)) end
            end
        end

        if method == "Raycast" and self == workspace then
            local origin = args[1]
            local direction = args[2]
            if origin and direction and TargetPart then
                if not ShouldHit() then return oldNamecall(self, ...) end

                local newOrigin = origin
                if _G.BulletTP then
                    newOrigin = applyBulletTeleport(origin, TargetPart)
                end

                local newDir = (TargetPart.Position - newOrigin).Unit * direction.Magnitude
                return oldNamecall(self, newOrigin, newDir, unpack(args, 3, argc))
            end
        end

        if type(method) == "string" and string.find(method, "FindPartOnRay", 1, true) and self == workspace then
            local ray = args[1]
            if ray and typeof(ray) == "Ray" and TargetPart then
                if not ShouldHit() then return oldNamecall(self, ...) end

                local origin = ray.Origin
                local newOrigin = _G.BulletTP and applyBulletTeleport(origin, TargetPart) or origin
                args[1] = Ray.new(newOrigin, (TargetPart.Position - newOrigin).Unit * ray.Direction.Magnitude)
                return oldNamecall(self, unpack(args, 1, argc))
            end
        end

        return oldNamecall(self, ...)
    end)
end

if not oldIndex then
    oldIndex = hookmetamethod(game, "__index", function(self, key)
        if checkcaller() then return oldIndex(self, key) end
        if self == Mouse and _G.SilentAim and TargetPart then
            local keyLower = string.lower(tostring(key))
            if keyLower == "hit" then
                if not ShouldHit() then return oldIndex(self, key) end
                if _G.BulletTP then
                    return CFrame.new(applyBulletTeleport(Camera.CFrame.Position, TargetPart))
                end
                return CFrame.new(TargetPart.Position)
            elseif keyLower == "target" then
                if not ShouldHit() then return oldIndex(self, key) end
                return TargetPart
            elseif keyLower == "unitray" then
                if not ShouldHit() then return oldIndex(self, key) end
                local origin = Camera.CFrame.Position
                local targetPos = _G.BulletTP and applyBulletTeleport(origin, TargetPart) or TargetPart.Position
                return Ray.new(origin, (targetPos - origin).Unit)
            end
        end
        return oldIndex(self, key)
    end)
end

