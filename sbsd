local ConfigFolder = "NotNoxia/configs"
local AutoloadFile = "NotNoxia/autoload.txt"
local ConfigIgnore = { ConfigName = true, ConfigList = true }

local function EnsureFolders()
    pcall(function()
        if makefolder then
            if not isfolder("NotNoxia") then makefolder("NotNoxia") end
            if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end
        end
    end)
end

local function SanitizeName(n)
    n = tostring(n or ""):gsub("[^%w%-_ ]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    return n
end

local function ListConfigs()
    local out = {}
    pcall(function()
        EnsureFolders()
        if listfiles then
            for _, path in ipairs(listfiles(ConfigFolder)) do
                local name = tostring(path):match("([^/\\]+)%.json$")
                if name then table.insert(out, name) end
            end
        end
    end)
    table.sort(out)
    return out
end

local function SerializeUI()
    local data = {}
    for id, o in pairs(Options) do
        if not ConfigIgnore[id] then
            local t = o.Type
            if t == "Toggle" or t == "Slider" or t == "Input" then
                data[id] = { t = t, v = o.Value }
            elseif t == "Dropdown" then
                if o.Multi then
                    local list = {}
                    for _, val in ipairs(o.Values or {}) do
                        if type(o.Value) == "table" and o.Value[val] then table.insert(list, val) end
                    end
                    data[id] = { t = t, m = true, v = list }
                else
                    data[id] = { t = t, v = o.Value }
                end
            elseif t == "ColorPicker" and typeof(o.Value) == "Color3" then
                local c = o.Value
                data[id] = { t = t, v = {
                    math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)
                } }
            elseif t == "KeyPicker" then
                data[id] = { t = t, v = tostring(o.Value) }
            end
        end
    end
    return data
end

local function ApplyUI(data)
    local applied = 0
    for id, d in pairs(data or {}) do
        local o = Options[id]
        if o and type(d) == "table" and not ConfigIgnore[id] then
            local ok = pcall(function()
                if d.t == "Toggle" then
                    if o.Value ~= d.v then o:SetValue(d.v) end
                elseif d.t == "Slider" then
                    o:SetValue(tonumber(d.v))
                elseif d.t == "Input" then
                    o:SetValue(tostring(d.v))
                elseif d.t == "Dropdown" then
                    if d.m then
                        local map = {}
                        for _, val in ipairs(d.v or {}) do map[val] = true end
                        o:SetValue(map)
                    elseif d.v ~= nil then
                        o:SetValue(d.v)
                    end
                elseif d.t == "ColorPicker" then
                    o:SetValue(Color3.fromRGB(d.v[1], d.v[2], d.v[3]))
                elseif d.t == "KeyPicker" then
                    o:SetValue(d.v)
                end
            end)
            if ok then applied = applied + 1 end
        end
    end
    ApplyBackground(false)
    return applied
end

local function SaveConfig(name)
    name = SanitizeName(name)
    if name == "" then return false, "Invalid name" end
    if not (writefile and HttpService) then return false, "Your executor does not support writefile" end
    EnsureFolders()
    local ok, err = pcall(function()
        writefile(ConfigFolder .. "/" .. name .. ".json", HttpService:JSONEncode(SerializeUI()))
    end)
    if not ok then return false, tostring(err) end
    return true
end

local function LoadConfig(name)
    name = SanitizeName(name)
    if name == "" then return false, "Invalid name" end
    if not (readfile and isfile) then return false, "Your executor does not support readfile" end
    local path = ConfigFolder .. "/" .. name .. ".json"
    if not isfile(path) then return false, "Config not found" end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(data) ~= "table" then return false, "Invalid config file" end
    return true, ApplyUI(data)
end

